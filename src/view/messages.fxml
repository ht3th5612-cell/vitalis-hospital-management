<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.MessageController">

    <VBox spacing="2.0">
        <Label styleClass="page-title" text="Messages"/>
    </VBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="320.0" spacing="10.0" styleClass="card" minWidth="280.0">
            <TextField fx:id="txtSearch" promptText="Search staff"/>
            <ListView fx:id="contactList" VBox.vgrow="ALWAYS" styleClass="chat-contacts"/>
        </VBox>

        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
            <Label fx:id="lblChatTitle" styleClass="section-title" text="Select a staff member to start chatting"/>
            <HBox fx:id="pinnedBar" alignment="CENTER_LEFT" managed="false" onMouseClicked="#handlePinnedClick" spacing="10.0" styleClass="chat-pinned" visible="false">
                <Label styleClass="chat-pin-tag" text="Pinned"/>
                <Label fx:id="lblPinnedText" maxWidth="1.7976931348623157E308" styleClass="muted" HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblPinnedCount" styleClass="muted"/>
            </HBox>
            <ScrollPane fx:id="chatScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="chatBox" spacing="6.0">
                    <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
                    </padding>
                </VBox>
            </ScrollPane>
            <HBox fx:id="inputBar" alignment="CENTER" spacing="6.0">
                <Button fx:id="btnAttach" onAction="#handleAttach" styleClass="chat-icon-button">
                    <graphic>
                        <SVGPath content="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z" styleClass="chat-icon"/>
                    </graphic>
                </Button>
                <TextField fx:id="txtMessage" promptText="Write a message and press Enter" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEmoji" onAction="#handleEmoji" styleClass="chat-icon-button">
                    <graphic>
                        <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z" styleClass="chat-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnSend" minWidth="-Infinity" onAction="#handleSend" text="Send"/>
            </HBox>
            <Label fx:id="lblStatus" styleClass="error-label" wrapText="true" text=""/>
        </VBox>
    </HBox>
</VBox>
