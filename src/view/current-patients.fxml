<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.CurrentPatientsController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label styleClass="page-title" text="In hospital now"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblCount" styleClass="muted" text=""/>
        <Button onAction="#handleRefresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <VBox spacing="8.0" styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPatient" prefWidth="140.0" text="Patient"/>
                <TableColumn fx:id="colDoctor" prefWidth="130.0" text="Doctor"/>
                <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status"/>
                <TableColumn fx:id="colRoom" prefWidth="90.0" text="Room"/>
                <TableColumn fx:id="colSince" prefWidth="125.0" text="Since"/>
                <TableColumn fx:id="colVitals" prefWidth="220.0" text="Latest vital signs"/>
                <TableColumn fx:id="colDiagnosis" prefWidth="200.0" text="Diagnosis"/>
            </columns>
        </TableView>
    </VBox>
</VBox>

