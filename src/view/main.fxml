<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1240.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainController">

    <left>
        <VBox prefWidth="250.0" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="sidebar-brand">
                <ImageView fitHeight="40.0" fitWidth="40.0" preserveRatio="true">
                    <Image url="@../images/icons/nav/patients.gif"/>
                </ImageView>
                <VBox spacing="1.0">
                    <Label styleClass="brand-title" text="VITALIS"/>
                    <Label styleClass="brand-subtitle" text="HOSPITAL MANAGEMENT SYSTEM"/>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="navBox" spacing="4.0"/>
            </ScrollPane>

            <VBox spacing="10.0" styleClass="sidebar-footer">
                <HBox alignment="CENTER_LEFT" onMouseClicked="#handleOpenProfile" spacing="10.0" styleClass="user-card">
                    <StackPane fx:id="avatarBox" minHeight="38.0" minWidth="38.0" prefHeight="38.0" prefWidth="38.0"/>
                    <VBox spacing="1.0">
                        <Label fx:id="lblUserName" styleClass="sidebar-user" text="Staff"/>
                        <Label fx:id="lblUserRole" styleClass="sidebar-role" text="" wrapText="true"/>
                    </VBox>
                </HBox>
                <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-button" text="Sign out"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>

