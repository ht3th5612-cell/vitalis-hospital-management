<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" styleClass="page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ReportController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label styleClass="page-title" text="Reports"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblUpdated" styleClass="muted" text=""/>
        <Button onAction="#handleRefresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <HBox spacing="16.0">
        <HBox alignment="CENTER_LEFT" prefWidth="235.0" spacing="14.0" styleClass="stat-card">
            <StackPane styleClass="stat-icon-tile">
                <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                    <Image url="@../images/icons/stat/dash-collected.gif"/>
                </ImageView>
            </StackPane>
            <VBox spacing="3.0">
                <Label styleClass="stat-label" text="INCOME THIS MONTH"/>
                <Label fx:id="lblIncome" styleClass="stat-value" text="\$0.00"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefWidth="235.0" spacing="14.0" styleClass="stat-card">
            <StackPane styleClass="stat-icon-tile">
                <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                    <Image url="@../images/icons/stat/billing-outstanding.gif"/>
                </ImageView>
            </StackPane>
            <VBox spacing="3.0">
                <Label styleClass="stat-label" text="EXPENSES THIS MONTH"/>
                <Label fx:id="lblExpense" styleClass="stat-value" text="\$0.00"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefWidth="235.0" spacing="14.0" styleClass="stat-card">
            <StackPane styleClass="stat-icon-tile">
                <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                    <Image url="@../images/icons/stat/reports-financial.gif"/>
                </ImageView>
            </StackPane>
            <VBox spacing="3.0">
                <Label styleClass="stat-label" text="PROFIT THIS MONTH"/>
                <Label fx:id="lblProfit" styleClass="stat-value" text="\$0.00"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefWidth="235.0" spacing="14.0" styleClass="stat-card">
            <StackPane styleClass="stat-icon-tile">
                <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                    <Image url="@../images/icons/stat/store-waiting.gif"/>
                </ImageView>
            </StackPane>
            <VBox spacing="3.0">
                <Label styleClass="stat-label" text="LOW STOCK ITEMS"/>
                <Label fx:id="lblLowStock" styleClass="stat-value" text="0"/>
            </VBox>
        </HBox>
    </HBox>

    <VBox spacing="8.0" styleClass="card" VBox.vgrow="ALWAYS">
        <Label styleClass="section-title" text="Income and expenses - last six months"/>
        <Label fx:id="lblExplain" styleClass="muted" text="" wrapText="true"/>
        <StackPane fx:id="chartBox" prefHeight="210.0" VBox.vgrow="ALWAYS"/>
    </VBox>

    <HBox prefHeight="190.0" spacing="16.0">
        <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="section-title" text="Medicine usage"/>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkAllTime" text="All time"/>
            </HBox>
            <TableView fx:id="usageTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colUsedItem" prefWidth="210.0" text="Medicine"/>
                    <TableColumn fx:id="colUsedQty" prefWidth="80.0" text="Used"/>
                    <TableColumn fx:id="colUsedSales" prefWidth="100.0" text="Sales"/>
                    <TableColumn fx:id="colUsedCost" prefWidth="100.0" text="Cost"/>
                </columns>
            </TableView>
        </VBox>
        <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Low stock alerts"/>
            <TableView fx:id="lowStockTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colItem" prefWidth="210.0" text="Item"/>
                    <TableColumn fx:id="colStock" prefWidth="80.0" text="Stock"/>
                    <TableColumn fx:id="colReorder" prefWidth="100.0" text="Reorder level"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>

