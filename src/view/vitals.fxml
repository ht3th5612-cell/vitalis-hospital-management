<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.VitalController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label styleClass="page-title" text="Patient vitals"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtSearch" prefWidth="250.0" promptText="Search patient or nurse"/>
        <Button onAction="#handleRefresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="section-title" text="Vitals history"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" styleClass="error-label" text=""/>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                    <TableColumn fx:id="colPatient" prefWidth="150.0" text="Patient"/>
                    <TableColumn fx:id="colNurse" prefWidth="135.0" text="Recorded by"/>
                    <TableColumn fx:id="colBp" prefWidth="95.0" text="BP"/>
                    <TableColumn fx:id="colTemp" prefWidth="85.0" text="Temp"/>
                    <TableColumn fx:id="colPulse" prefWidth="65.0" text="Pulse"/>
                    <TableColumn fx:id="colRecorded" prefWidth="145.0" text="Recorded"/>
                </columns>
            </TableView>
        </VBox>

        <VBox fx:id="formCard" prefWidth="330.0" spacing="8.0" styleClass="card">
            <Label styleClass="section-title" text="New vital record"/>

            <Label styleClass="field-label" text="PATIENT"/>
            <ComboBox fx:id="cmbPatient" maxWidth="Infinity" promptText="Select patient"/>

            <Label styleClass="field-label" text="BLOOD PRESSURE (e.g. 120/80)"/>
            <TextField fx:id="txtBp" promptText="120/80"/>

            <Label styleClass="field-label" text="TEMPERATURE (°C)"/>
            <TextField fx:id="txtTemp" promptText="36.8"/>

            <Label styleClass="field-label" text="PULSE (BPM)"/>
            <TextField fx:id="txtPulse" promptText="72"/>

            <Label styleClass="field-label" text="NOTES"/>
            <TextField fx:id="txtNotes" promptText="Optional notes"/>

            <Button maxWidth="Infinity" onAction="#handleSave" text="Save vitals">
                <VBox.margin>
                    <Insets top="4.0"/>
                </VBox.margin>
            </Button>
            <HBox spacing="8.0">
                <Button maxWidth="Infinity" onAction="#handleDelete" HBox.hgrow="ALWAYS"
                        styleClass="button-danger" text="Delete selected"/>
                <Button onAction="#handleClear" styleClass="button-secondary" text="Clear"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>

