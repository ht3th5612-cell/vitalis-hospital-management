<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ConsultationController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label styleClass="page-title" text="Consultation"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#handleRefresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="section-title" text="My patients"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" styleClass="error-label" text=""/>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPatient" prefWidth="140.0" text="Patient"/>
                    <TableColumn fx:id="colDate" prefWidth="95.0" text="Date"/>
                    <TableColumn fx:id="colTime" prefWidth="55.0" text="Time"/>
                    <TableColumn fx:id="colReason" prefWidth="170.0" text="Reason"/>
                    <TableColumn fx:id="colStatus" prefWidth="80.0" text="Status"/>
                </columns>
            </TableView>
            <Label styleClass="field-label" text="PATIENT WITHOUT AN APPOINTMENT"/>
            <HBox spacing="8.0">
                <Label fx:id="lblWalkIn" maxWidth="Infinity" text="No patient chosen" wrapText="true" HBox.hgrow="ALWAYS"/>
                <Button minWidth="-Infinity" onAction="#handleFindPatient" styleClass="button-secondary" text="Find patient"/>
                <Button minWidth="-Infinity" onAction="#handleWalkIn" styleClass="button-success" text="See now"/>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="390.0" styleClass="form-scroll">
            <VBox spacing="7.0" styleClass="card">
                <Label styleClass="section-title" text="Consultation"/>
                <Label fx:id="lblPatient" styleClass="field-label" text="Select a patient from the list." wrapText="true"/>
                <Label fx:id="lblVitals" styleClass="muted" text="" wrapText="true"/>

                <Label styleClass="field-label" text="EARLIER DIAGNOSES"/>
                <ListView fx:id="lstHistory" prefHeight="85.0"/>

                <Label styleClass="field-label" text="DIAGNOSIS"/>
                <TextField fx:id="txtDiagnosis" promptText="What is the illness?"/>

                <Label styleClass="field-label" text="PRESCRIPTION"/>
                <TextArea fx:id="txtPrescription" prefRowCount="3" promptText="Medicines and how to take them" wrapText="true"/>

                <Label styleClass="field-label" text="NOTES"/>
                <TextArea fx:id="txtNotes" prefRowCount="2" promptText="Advice, follow-up" wrapText="true"/>

                <Button fx:id="btnComplete" maxWidth="Infinity" onAction="#handleComplete" styleClass="button-success"
                        text="Save and complete the visit">
                    <VBox.margin>
                        <Insets top="3.0"/>
                    </VBox.margin>
                </Button>

                <Label styleClass="field-label" text="OR ADMIT THE PATIENT TO A ROOM"/>
                <ComboBox fx:id="cmbRoom" maxWidth="Infinity" promptText="Select a room with a free bed"/>
                <Button fx:id="btnAdmit" maxWidth="Infinity" onAction="#handleAdmit" text="Save and admit"/>

                <Button fx:id="btnNote" maxWidth="Infinity" onAction="#handleNote" styleClass="button-secondary"
                        text="Save a note only (the patient stays)"/>
            </VBox>
        </ScrollPane>
    </HBox>
</VBox>

