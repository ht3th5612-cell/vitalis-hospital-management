<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.MedicalRecordController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label styleClass="page-title" text="Medical records"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtSearch" prefWidth="250.0" promptText="Search patient, doctor or diagnosis"/>
        <Button onAction="#handleRefresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="section-title" text="Record history"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" styleClass="error-label" text=""/>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                    <TableColumn fx:id="colPatient" prefWidth="125.0" text="Patient"/>
                    <TableColumn fx:id="colDoctor" prefWidth="125.0" text="Doctor"/>
                    <TableColumn fx:id="colDiagnosis" prefWidth="210.0" text="Diagnosis"/>
                    <TableColumn fx:id="colPrescription" prefWidth="210.0" text="Prescription"/>
                    <TableColumn fx:id="colDate" prefWidth="120.0" text="Date"/>
                </columns>
            </TableView>
        </VBox>

        <VBox fx:id="formCard" prefWidth="330.0" spacing="7.0" styleClass="card">
            <Label styleClass="section-title" text="New medical record"/>

            <Label styleClass="field-label" text="PATIENT"/>
            <ComboBox fx:id="cmbPatient" maxWidth="Infinity" promptText="Select patient"/>

            <Label styleClass="field-label" text="DIAGNOSIS"/>
            <TextArea fx:id="txtDiagnosis" prefHeight="75.0" promptText="Diagnosis" wrapText="true"/>

            <Label styleClass="field-label" text="PRESCRIPTION"/>
            <TextArea fx:id="txtPrescription" prefHeight="75.0" promptText="Medicines and dosage" wrapText="true"/>

            <Label styleClass="field-label" text="NOTES"/>
            <TextArea fx:id="txtNotes" prefHeight="60.0" promptText="Follow-up notes" wrapText="true"/>

            <Button maxWidth="Infinity" onAction="#handleSave" text="Save record">
                <VBox.margin>
                    <Insets top="3.0"/>
                </VBox.margin>
            </Button>
            <Button maxWidth="Infinity" onAction="#handleClear" styleClass="button-secondary" text="Clear"/>
        </VBox>
    </HBox>
</VBox>

