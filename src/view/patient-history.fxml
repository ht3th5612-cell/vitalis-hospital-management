<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.PatientHistoryController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label styleClass="page-title" text="Patient history"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="txtSearch" prefWidth="260.0" promptText="Search name, NRC, phone, e-mail"/>
        <Button minWidth="-Infinity" onAction="#handleRefresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <VBox spacing="8.0" styleClass="card" VBox.vgrow="ALWAYS">
        <Label styleClass="section-title" text="Patients"/>
        <TableView fx:id="patients" prefHeight="210.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="55.0" text="ID"/>
                <TableColumn fx:id="colName" prefWidth="150.0" text="Name"/>
                <TableColumn fx:id="colBirth" prefWidth="95.0" text="Born"/>
                <TableColumn fx:id="colAge" prefWidth="45.0" text="Age"/>
                <TableColumn fx:id="colGender" prefWidth="70.0" text="Gender"/>
                <TableColumn fx:id="colNrc" prefWidth="140.0" text="NRC"/>
                <TableColumn fx:id="colPhone" prefWidth="105.0" text="Phone"/>
                <TableColumn fx:id="colEmail" prefWidth="150.0" text="E-mail"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="8.0" styleClass="card" VBox.vgrow="ALWAYS">
        <Label fx:id="lblSelected" styleClass="section-title" text="Select a patient above"/>
        <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="220.0" VBox.vgrow="ALWAYS">
            <Tab text="Visits">
                <TableView fx:id="visits">
                    <columns>
                        <TableColumn fx:id="colVisitDate" prefWidth="110.0" text="Date"/>
                        <TableColumn fx:id="colVisitDoctor" prefWidth="160.0" text="Doctor"/>
                        <TableColumn fx:id="colVisitReason" prefWidth="220.0" text="Reason"/>
                        <TableColumn fx:id="colVisitType" prefWidth="85.0" text="Type"/>
                        <TableColumn fx:id="colVisitRoom" prefWidth="100.0" text="Room"/>
                        <TableColumn fx:id="colVisitStatus" prefWidth="90.0" text="Status"/>
                    </columns>
                </TableView>
            </Tab>
            <Tab text="Medical records">
                <TableView fx:id="records">
                    <columns>
                        <TableColumn fx:id="colRecDate" prefWidth="120.0" text="Date"/>
                        <TableColumn fx:id="colRecDoctor" prefWidth="140.0" text="Doctor"/>
                        <TableColumn fx:id="colRecDiagnosis" prefWidth="200.0" text="Diagnosis"/>
                        <TableColumn fx:id="colRecPrescription" prefWidth="220.0" text="Prescription"/>
                        <TableColumn fx:id="colRecNotes" prefWidth="180.0" text="Notes"/>
                    </columns>
                </TableView>
            </Tab>
            <Tab text="Vital signs">
                <TableView fx:id="vitals">
                    <columns>
                        <TableColumn fx:id="colVitDate" prefWidth="130.0" text="Recorded"/>
                        <TableColumn fx:id="colVitBp" prefWidth="90.0" text="BP"/>
                        <TableColumn fx:id="colVitTemp" prefWidth="90.0" text="Temp"/>
                        <TableColumn fx:id="colVitPulse" prefWidth="80.0" text="Pulse"/>
                        <TableColumn fx:id="colVitNurse" prefWidth="150.0" text="Recorded by"/>
                        <TableColumn fx:id="colVitNotes" prefWidth="200.0" text="Notes"/>
                    </columns>
                </TableView>
            </Tab>
        </TabPane>
    </VBox>
</VBox>

