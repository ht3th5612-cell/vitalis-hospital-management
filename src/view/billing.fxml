<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="page"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BillingController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label fx:id="lblTitle" styleClass="page-title" text="Checkout"/>
            <Label fx:id="lblSubtitle" styleClass="muted" text=""/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblSummary" styleClass="muted" text=""/>
        <TextField fx:id="txtSearch" prefWidth="230.0" promptText="Search patient or item"/>
        <Button onAction="#handleRefresh" styleClass="button-secondary" text="Refresh"/>
    </HBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label styleClass="section-title" text="Bill lines"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" styleClass="error-label" text=""/>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="45.0" text="ID"/>
                    <TableColumn fx:id="colPatient" prefWidth="115.0" text="Patient"/>
                    <TableColumn fx:id="colDescription" prefWidth="210.0" text="Item"/>
                    <TableColumn fx:id="colType" prefWidth="70.0" text="Type"/>
                    <TableColumn fx:id="colAmount" prefWidth="75.0" text="Amount"/>
                    <TableColumn fx:id="colStatus" prefWidth="65.0" text="Status"/>
                    <TableColumn fx:id="colMethod" prefWidth="90.0" text="Method"/>
                    <TableColumn fx:id="colDate" prefWidth="120.0" text="Date"/>
                </columns>
            </TableView>
            <HBox spacing="8.0">
                <Button minWidth="-Infinity" onAction="#handleReceipt" text="Show receipt"/>
                <Button fx:id="btnMarkPaid" minWidth="-Infinity" onAction="#handleMarkPaid" styleClass="button-secondary"
                        text="Mark old bill paid"/>
            </HBox>
        </VBox>

        <ScrollPane fx:id="formCard" fitToWidth="true" hbarPolicy="NEVER" prefWidth="370.0" styleClass="form-scroll">
            <VBox spacing="7.0" styleClass="card">
                <Label styleClass="section-title" text="Pay a visit"/>

                <Label styleClass="field-label" text="VISIT"/>
                <ComboBox fx:id="cmbVisit" maxWidth="Infinity" promptText="Select a visit to pay"/>

                <Label styleClass="field-label" text="MEDICINE (OPTIONAL)"/>
                <ComboBox fx:id="cmbMedicine" maxWidth="Infinity" promptText="Select medicine"/>
                <HBox spacing="8.0">
                    <TextField fx:id="txtQuantity" prefWidth="90.0" promptText="Quantity"/>
                    <Button minWidth="-Infinity" maxWidth="Infinity" onAction="#handleAddMedicine" HBox.hgrow="ALWAYS"
                            styleClass="button-secondary" text="Add medicine"/>
                </HBox>
                <ListView fx:id="lstMedicines" prefHeight="70.0"/>
                <Button maxWidth="Infinity" onAction="#handleRemoveMedicine" styleClass="button-secondary"
                        text="Remove selected medicine"/>

                <Label styleClass="field-label" text="THE BILL"/>
                <TextArea fx:id="txtBill" editable="false" prefRowCount="7" wrapText="true"/>
                <Label fx:id="lblTotal" styleClass="section-title" text="Total: $0.00"/>

                <Label styleClass="field-label" text="PAYMENT METHOD"/>
                <ComboBox fx:id="cmbMethod" maxWidth="Infinity"/>

                <Button fx:id="btnPay" maxWidth="Infinity" onAction="#handlePay" styleClass="button-success"
                        text="Pay and show receipt">
                    <VBox.margin>
                        <Insets top="3.0"/>
                    </VBox.margin>
                </Button>
                <Button maxWidth="Infinity" onAction="#handleClear" styleClass="button-secondary" text="Clear"/>
            </VBox>
        </ScrollPane>
    </HBox>
</VBox>

